# Optional systemd user service: ~/.config/systemd/user/tgv-ui.service
# Deploy ui/build, package.json and production dependencies to the directory below.
# Adjust the absolute Node path for your host. No dependency on tgv.service:
# the daemon may run remotely, and either service can restart independently.
[Unit]
Description=TGV SvelteKit inspection UI
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/.local/share/tgv-ui
ExecStart=/usr/bin/node build
Environment=HOST=127.0.0.1 PORT=3000
EnvironmentFile=%h/.config/tgv/ui.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tgv-ui

[Install]
WantedBy=default.target
