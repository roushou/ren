# Example systemd user service: ~/.config/systemd/user/tgv.service
[Unit]
Description=TGV gateway for coding agents
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=:"%h/.local/bin/tgv" --config "%h/.config/tgv/tgv.toml" --data-dir "%h/.local/state/tgv" serve
WorkingDirectory=/
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tgv

[Install]
WantedBy=default.target
