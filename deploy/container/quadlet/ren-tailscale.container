# Podman Quadlet: Tailscale for the Ren pod, serving HTTPS on the tailnet.
[Unit]
Description=Tailscale for the Ren pod

[Container]
ContainerName=ren-tailscale
Image=docker.io/tailscale/tailscale:stable
Pod=ren.pod
Environment=TS_HOSTNAME=ren TS_STATE_DIR=/var/lib/tailscale TS_USERSPACE=true TS_SERVE_CONFIG=/config/serve.json
# TS_AUTHKEY=... for the first start; without it, the log prints a login URL.
EnvironmentFile=%h/.config/ren/tailscale.env
Volume=ren-tailscale.volume:/var/lib/tailscale
Volume=%h/.config/ren/tailscale-serve.json:/config/serve.json:ro,Z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
