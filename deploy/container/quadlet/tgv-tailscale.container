# Podman Quadlet: Tailscale for the TGV pod, serving HTTPS on the tailnet.
[Unit]
Description=Tailscale for the TGV pod

[Container]
ContainerName=tgv-tailscale
Image=docker.io/tailscale/tailscale:stable
Pod=tgv.pod
Environment=TS_HOSTNAME=tgv TS_STATE_DIR=/var/lib/tailscale TS_USERSPACE=true TS_SERVE_CONFIG=/config/serve.json
# TS_AUTHKEY=... for the first start; without it, the log prints a login URL.
EnvironmentFile=%h/.config/tgv/tailscale.env
Volume=tgv-tailscale.volume:/var/lib/tailscale
Volume=%h/.config/tgv/tailscale-serve.json:/config/serve.json:ro,Z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
